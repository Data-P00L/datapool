# ==============================================================================
# DattaPool Environment Configuration Template
# 
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys, passwords, or tokens to version control.
# ==============================================================================

# Bitcoin Core RPC Configuration (Regtest / Local Dev)
BITCOIN_NETWORK=regtest
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443
BITCOIN_RPC_USER=dattapool
BITCOIN_RPC_PASSWORD=change-me

# LND Daemon Configuration
LND_HOST=127.0.0.1:10009
LND_MACAROON_PATH=/path/to/admin.macaroon
LND_TLS_CERT_PATH=/path/to/tls.cert

# Taproot Assets (tapd) Daemon Configuration
TAPD_HOST=127.0.0.1:10029
TAPD_MACAROON_PATH=/path/to/admin.macaroon
TAPD_TLS_CERT_PATH=/path/to/tls.cert

# Nostr Witness & Relay Configuration
# Replace with your local or test Nostr relay URL
NOSTR_RELAY_URL=wss://example-relay.invalid
NOSTR_STORE_DIR=./session_data/nostr_store

# Freshness & Witness Service
FRESHNESS_PORT=8090
FRESHNESS_HOST=0.0.0.0

# YouTube Publication & Discovery (Optional Developer Configuration)
# Developers must create their own Google Cloud OAuth 2.0 Client credentials:
# See docs/youtube-publication.md for setup instructions.
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret-placeholder
YOUTUBE_UPLOAD_VISIBILITY=unlisted
